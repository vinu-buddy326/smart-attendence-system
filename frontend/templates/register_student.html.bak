<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Enrollment — Smart Attendance AI</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { display:flex; align-items:center; justify-content:center; min-height:100vh; padding:2rem 1rem; }
        .register-wrap { width:100%; max-width:700px; animation: fadeIn 0.7s ease; }
        .register-card {
            background: rgba(8,13,36,0.9);
            backdrop-filter: blur(24px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 3rem;
            box-shadow: 0 30px 80px rgba(0,0,0,0.5);
        }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
        .preview-img {
            width: 72px; height: 72px;
            border-radius: 12px;
            object-fit: cover;
            border: 2px solid var(--highlight);
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            transition: transform 0.2s ease;
        }
        .preview-img:hover { transform: scale(1.1); }
        .upload-area {
            border: 2px dashed rgba(0, 255, 159, 0.3);
            border-radius: 20px;
            padding: 3.5rem 2rem;
            text-align: center;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            background: rgba(0, 255, 159, 0.02);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            position: relative;
            overflow: hidden;
        }
        .upload-area::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, rgba(0, 255, 159, 0.05), transparent 70%);
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        .upload-area:hover::before { opacity: 1; }
        .upload-area i { 
            font-size: 3.2rem; 
            color: var(--success); 
            filter: drop-shadow(0 0 10px rgba(0, 255, 159, 0.4));
            margin-bottom: 5px;
        }
        @media (max-width: 560px) {
            .grid-2 { grid-template-columns: 1fr; gap: 0; }
            .register-card { padding: 1.8rem 1.2rem; }
        }
    </style>
</head>
<body>
<div class="register-wrap">
    <div style="text-align:center;margin-bottom:1.5rem">
        <a href="/login" class="btn-ghost" style="font-size:0.8rem;display:inline-flex"><i class="fas fa-arrow-left"></i> Back to Login</a>
    </div>

    <div class="register-card">
        <!-- Header -->
        <div style="text-align:center;margin-bottom:2.5rem">
            <div style="width:75px;height:75px;border-radius:22px;background:linear-gradient(135deg,rgba(26,115,232,0.2),rgba(0,255,159,0.2));margin:0 auto 1.5rem;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,0.08)">
                <i class="fas fa-id-badge" style="font-size:2.2rem;background:linear-gradient(135deg,var(--highlight),var(--success));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text"></i>
            </div>
            <h1 style="font-size:1.8rem;font-weight:700;margin-bottom:0.4rem">Student Enrollment</h1>
            <p class="text-dim">Register your biometric identity for AI attendance tracking</p>
        </div>

        <!-- Flash Messages -->
        {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}{% for cat, msg in messages %}
        <div class="alert alert-{{ 'success' if cat == 'success' else 'error' }}">
            <i class="fas fa-{{ 'check-circle' if cat == 'success' else 'exclamation-triangle' }}"></i>
            <span>{{ msg|safe }}</span>
        </div>
        {% endfor %}{% endif %}
        {% endwith %}

        <form action="{{ url_for('register_student') }}" method="POST" enctype="multipart/form-data" id="registerForm">
            <div class="grid-2">
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-user"></i> Full Name</label>
                    <input type="text" name="name" class="custom-input" placeholder="e.g. John Doe" required>
                </div>
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-id-card"></i> Roll / Register No.</label>
                    <input type="text" name="roll_number" class="custom-input" placeholder="e.g. REG2024001" required>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-envelope"></i> Email Address</label>
                    <input type="email" name="email" class="custom-input" placeholder="student@university.edu" required>
                </div>
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-phone"></i> Phone Number</label>
                    <input type="tel" name="phone" class="custom-input" placeholder="10-digit number" pattern="[0-9]{10}" required>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-university"></i> University Name</label>
                    <input type="text" name="university" class="custom-input" placeholder="e.g. Stanford University" required>
                </div>
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-school"></i> Name of School / College</label>
                    <input type="text" name="school" class="custom-input" placeholder="e.g. School of Engineering" required>
                </div>
            </div>
            
            <div class="form-group">
                <label class="form-label"><i class="fas fa-layer-group"></i> Academic Section</label>
                <input type="text" name="section" class="custom-input" placeholder="e.g. B1, Section-A, CSE-2" required>
            </div>

            <div class="form-group">
                <label class="form-label"><i class="fas fa-camera"></i> Facial Recognition Set (Exactly 5 Photos Compulsory)</label>
                <div style="font-size:0.75rem;color:var(--warning);margin-bottom:8px;background:rgba(255,184,0,0.1);padding:8px 12px;border-radius:8px;border:1px solid rgba(255,184,0,0.2)">
                    <i class="fas fa-circle-exclamation"></i> <strong>Important:</strong> Photos must be <strong>clear</strong> and taken from <strong>different angles</strong> (front, left, right, slightly up/down). 
                </div>
                <label for="photos" class="upload-area" id="uploadArea">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p style="font-weight:600;font-size:1rem;color:white;margin-bottom:0.4rem">Select EXACTLY 5 Photos</p>
                    <p class="text-dim" style="font-size:0.82rem">JPG or PNG format only</p>
                </label>
                <input type="file" name="photos" id="photos" accept="image/jpeg,image/jpg,image/png" multiple required style="display:none">
                <div id="previewContainer" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:1rem;justify-content:center"></div>
                <div id="photoCount" style="text-align:center;font-size:0.78rem;color:var(--text-dim);margin-top:6px"></div>
            </div>

            <div style="background:rgba(26,115,232,0.06);border:1px solid rgba(26,115,232,0.15);border-radius:12px;padding:1rem;margin-bottom:1.5rem">
                <div style="font-size:0.8rem;color:var(--text-dim);display:flex;gap:20px;flex-wrap:wrap">
                    <span><i class="fas fa-shield-halved" style="color:var(--success)"></i> Secure &amp; Encrypted Storage</span>
                    <span><i class="fas fa-microchip" style="color:var(--highlight)"></i> AI-Powered ID Generation</span>
                    <span><i class="fas fa-message" style="color:var(--warning)"></i> SMS Confirmation Sent</span>
                </div>
            </div>

            <button type="submit" class="btn-neon" style="width:100%;justify-content:center;padding:16px;font-size:1rem" id="submitBtn">
                <i class="fas fa-microchip"></i> Generate Identity Asset
            </button>
        </form>
    </div>
</div>

<script>
const fileInput = document.getElementById('photos');
const previewContainer = document.getElementById('previewContainer');
const photoCount = document.getElementById('photoCount');
const uploadArea = document.getElementById('uploadArea');

fileInput.addEventListener('change', function() {
    previewContainer.innerHTML = '';
    if (this.files.length !== 5) {
        alert('You MUST upload exactly 5 images to satisfy the biometric training requirements.');
        this.value = '';
        photoCount.textContent = '';
        return;
    }
    if (this.files.length > 0) {
        photoCount.textContent = `${this.files.length} photo${this.files.length > 1 ? 's' : ''} selected — first will be used for ID card`;
        uploadArea.style.borderColor = 'var(--success)';
        uploadArea.style.background = 'rgba(0,255,159,0.06)';
    }
    Array.from(this.files).forEach(file => {
        const reader = new FileReader();
        reader.onload = e => {
            const img = document.createElement('img');
            img.src = e.target.result;
            img.className = 'preview-img';
            img.title = file.name;
            previewContainer.appendChild(img);
        };
        reader.readAsDataURL(file);
    });
});

// Drag & drop handlers for visual feedback
['dragenter', 'dragover'].forEach(eventName => {
    uploadArea.addEventListener(eventName, e => {
        e.preventDefault();
        e.stopPropagation();
        uploadArea.style.borderColor = 'var(--success)';
        uploadArea.style.background = 'rgba(0, 255, 159, 0.08)';
        uploadArea.style.boxShadow = '0 0 20px rgba(0, 255, 159, 0.2)';
    }, false);
});

['dragleave', 'drop'].forEach(eventName => {
    uploadArea.addEventListener(eventName, e => {
        e.preventDefault();
        e.stopPropagation();
        if (fileInput.files.length === 0) {
            uploadArea.style.borderColor = 'rgba(0, 255, 159, 0.3)';
            uploadArea.style.background = 'rgba(0, 255, 159, 0.02)';
            uploadArea.style.boxShadow = 'none';
        }
    }, false);
});

uploadArea.addEventListener('drop', e => {
    fileInput.files = e.dataTransfer.files;
    fileInput.dispatchEvent(new Event('change'));
});

document.getElementById('registerForm').addEventListener('submit', () => {
    const btn = document.getElementById('submitBtn');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing Biometrics...';
    btn.disabled = true;
});
</script>
</body>
</html>
